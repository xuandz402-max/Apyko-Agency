# Copy file này thành .env khi chạy local (không commit file .env thật)
# Trên Render/Railway/Fly.io: nhập các biến này ở mục Environment Variables.

# BẮT BUỘC khi deploy: chuỗi bí mật dài ngẫu nhiên (dùng để bảo vệ mật khẩu)
SECRET_KEY=doi-chuoi-nay-thanh-ky-tu-ngau-nhien-that-dai

# Tài khoản chủ sở hữu tự tạo ở lần chạy đầu (bỏ trống để dùng trang /setup)
OWNER_USERNAME=
OWNER_PASSWORD=

# Đường dẫn file SQLite (mặc định ./data/apyko_agency.db)
# Bỏ qua nếu dùng Turso bên dưới.
DATABASE_PATH=

# Database online Turso (libsql) — chống mất dữ liệu khi Render/Railway deploy lại.
# Đủ cả 2 biến thì app dùng Turso remote; thiếu thì fallback SQLite local như cũ.
# Lấy tại https://turso.tech → Create Database (region Singapore) → copy URL,
# rồi tạo auth token:  turso db tokens create <ten-db>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cổng chạy app (hosting tự đặt qua biến PORT)
PORT=8000

# Đặt true khi chạy sau HTTPS (Render/Railway/Fly.io đều có HTTPS)
COOKIE_SECURE=false

# Số ngày duy trì đăng nhập
SESSION_DAYS=30
